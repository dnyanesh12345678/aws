  organization_aggregation_source {
    all_regions = true
    role_arn    = "arn:aws:iam::<ORG-MASTER-ACCOUNT-ID>:role/ConfigAggregatorRole"
  }
}
IAM role:

resource "aws_iam_role" "aggregator_role" {
