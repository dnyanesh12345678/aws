package demo;

import com.amazonaws.services.lambda.runtime.Context;
import com.amazonaws.services.lambda.runtime.RequestHandler;
import java.util.Map;

/**
 * Shows "cold start" work in static/ctor and "warm start" reuse on later invokes.
 */
public class HelloHandler implements RequestHandler<Map<String, Object>, String> {

    // Simulate heavy one-time initialization (cold-start work)
    static {
        System.out.println(">>> Cold start: static initializer running...");
        try {
            Thread.sleep(2000); // pretend to load configs, warm caches, etc.
        } catch (InterruptedException ignored) {}
    }

    // Runs once per execution environment (still part of cold start)
    public HelloHandler() {
        System.out.println(">>> Cold start: constructor running...");
    }

    @Override
    public String handleRequest(Map<String, Object> event, Context context) {
        String name = (String) event.getOrDefault("name", "World");
        System.out.println(">>> Handling requestId=" + context.getAwsRequestId());
        return "Hello, " + name + "!";
    }
}
